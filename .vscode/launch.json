{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Start Dev Server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
            "args": ["--port", "3000"],
            "console": "integratedTerminal"
        }
    ]
} 